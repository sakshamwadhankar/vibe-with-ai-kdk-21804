# ==========================================
# Vercel & Production Environment Variables
# ==========================================

# 1. Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# 2. Database (Neon PostgreSQL via Drizzle ORM)
NEXT_PUBLIC_DRIZZLE_DB_URL=postgresql://user:password@endpoint-pooler.region.neon.tech/neondb?sslmode=require

# 3. AI Model Provider Configuration
# Choose "gemini" (recommended for Vercel cloud) or "ollama"
AI_PROVIDER=gemini

# Option A: Google Gemini API (Recommended for Vercel deployment)
# Get a free key from https://aistudio.google.com
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Option B: Ollama (If self-hosting Ollama with a public tunnel or dedicated server)
OLLAMA_BASE_URL=https://your-public-tunnel.trycloudflare.com
OLLAMA_MODEL=qwen2.5:3b

# 4. App Defaults & Notes
NEXT_PUBLIC_INTERVIEW_QUESTION_COUNT=5
NEXT_PUBLIC_INFORMATION=Welcome to the AI Mock Interview. Answer the questions to the best of your ability.
NEXT_PUBLIC_QUESTION_NOTE=Ensure your microphone and camera permissions are enabled before starting.